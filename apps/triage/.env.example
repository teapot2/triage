# Meta Model API: the default provider for every stage until one is
# changed in Settings -> Models. MODEL_ID is that default model.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3

# Hosted open weights (Muse Glimmer, Muse Spark Open), for stages set to
# these providers in Settings. Local servers (LM Studio, Ollama, llama.cpp)
# and custom endpoints are configured in Settings instead.
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=

# Baseten: Muse Spark Open (meta-models/muse-spark-open-1026).
# BASETEN_API_KEY=
# BASETEN_API_BASE_URL=https://inference.baseten.co/v1

# Modal: Muse Glimmer on your own deployment of infra/modal/glimmer.py. The
# URL is the deployment's, ending in /v1; the key is the VLLM_API_KEY in its
# triage-glimmer secret.
# MODAL_BASE_URL=https://<workspace>--triage-glimmer-serve.modal.run/v1
# MODAL_API_KEY=

# Live investigations of Shopfront (the "Live Shopfront" option). Defaults
# work for the local monorepo layout; set these only if yours differs.
# TELEMETRY_DIR=../../infra/telemetry
# SHOPFRONT_DIR=../shopfront
# SHOPFRONT_DATABASE_URL=postgres://triage:triage@localhost:5433/shopfront
# Where an approved mitigation flips Shopfront's flags (its /api/ops).
# SHOPFRONT_URL=http://localhost:3001
# Minutes under the alert's threshold after a mitigation's recovery before
# Triage resolves the incident on its own (default 5).
# TRIAGE_RESOLVE_AFTER_MINUTES=5

# Lets endpoint checks target loopback and private addresses (a local demo
# on Shopfront). Never in production; link-local stays refused.
# TRIAGE_UPTIME_ALLOW_PRIVATE=1

# Where links in Slack notifications point: the address your team uses to
# reach this Triage (default http://localhost:3000).
# TRIAGE_URL=http://localhost:3000
