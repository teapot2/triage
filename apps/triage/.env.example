# Meta Model API: the default provider for every stage until one is
# changed in Settings -> Models. MODEL_ID is that default model.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3

# Hosted open weights (Muse Glimmer, Muse Spark Open), for stages set to
# these providers in Settings. Local servers (LM Studio, Ollama, llama.cpp)
# and custom endpoints are configured in Settings instead.
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=

# Live investigations of Shopfront (the "Live Shopfront" option). Defaults
# work for the local monorepo layout; set these only if yours differs.
# TELEMETRY_DIR=../../infra/telemetry
# SHOPFRONT_DIR=../shopfront
# SHOPFRONT_DATABASE_URL=postgres://triage:triage@localhost:5433/shopfront
