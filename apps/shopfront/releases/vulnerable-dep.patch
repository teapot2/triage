--- /dev/null
+++ b/apps/shopfront/src/types/semver.d.ts
@@ -0,0 +1,5 @@
+// semver 7.5 ships no types; the store only needs satisfies.
+declare module "semver" {
+  const semver: { satisfies(version: string, range: string): boolean };
+  export default semver;
+}
